# =============================================================================
# HealthConnect Africa — Environment Variable Placeholders (.env.example)
# Copy to .env for local development. NEVER commit .env or real secrets to Git.
# =============================================================================

# Server & Application URL
APP_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Interswitch Web Checkout (Official Documentation: docs.interswitchgroup.com)
# Obtain Merchant Code & Pay Item ID from Quickteller Business / Interswitch
# Merchant Dashboard -> Payment Gateway / Web Checkout Settings.
# Obtain Client ID & Secret Key from Interswitch Developer Console.
# -----------------------------------------------------------------------------
INTERSWITCH_PAY_ITEM_ID=
INTERSWITCH_MERCHANT_CODE=
INTERSWITCH_CLIENT_ID=
INTERSWITCH_SECRET_KEY=
INTERSWITCH_ENVIRONMENT=sandbox
INTERSWITCH_CALLBACK_URL=
INTERSWITCH_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# AI Health Assistant (Server-Side Only — Never expose to frontend)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Google Maps (Client-Side Restricted Key)
# -----------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# SMS OTP Verification & Automated Emergency SMS (Twilio / Termii — Server-Side Only)
# -----------------------------------------------------------------------------
TERMII_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Administrator Allowlist (Comma-separated verified admin emails, optional)
# -----------------------------------------------------------------------------
ADMIN_EMAILS=
